# Google OAuth (Web application client) - see CLAUDE.md for setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the client, and the port the app listens on
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Bill actions (optional) - see CLAUDE.md "actions/"
# Directory for data/actions.json and data/bill-runs.json (default ./data; Google token/historyId always use ./data)
# DATA_DIR=./data
# Override the actions config location
# ACTIONS_CONFIG_PATH=./data/actions.json
